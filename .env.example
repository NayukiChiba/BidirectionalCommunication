# 使用以下命令生成随机密钥：python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=replace-me
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15

# PostgreSQL；密码建议使用 URL 安全的随机十六进制字符串
POSTGRES_USER=chat
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_DB=chat
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://chat:replace-with-random-password@127.0.0.1:5432/chat
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# 单实例 WebSocket 资源保护
WS_MAX_MESSAGE_BYTES=16384
WS_INPUT_RATE_LIMIT_COUNT=30
WS_INPUT_RATE_LIMIT_WINDOW_SECONDS=10
WS_MAX_CONNECTIONS=1000

# 就绪检查与结构化日志
READINESS_TIMEOUT_SECONDS=1
LOG_LEVEL=INFO

# Docker Compose 映射到宿主机的端口
APP_PORT=8000
