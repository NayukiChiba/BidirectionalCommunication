# 使用以下命令生成随机密钥：python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=replace-me
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15

# 单实例 WebSocket 资源保护
WS_MAX_MESSAGE_BYTES=16384
WS_INPUT_RATE_LIMIT_COUNT=30
WS_INPUT_RATE_LIMIT_WINDOW_SECONDS=10
WS_MAX_CONNECTIONS=1000

# 就绪检查与结构化日志
READINESS_TIMEOUT_SECONDS=1
LOG_LEVEL=INFO

# Docker Compose 映射到宿主机的端口
APP_PORT=8000
