# python main.py 不需要本文件；以下配置仅用于外部服务或 Docker 部署
# 使用以下命令生成随机密钥：python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=replace-me
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15

# PostgreSQL；密码建议使用 URL 安全的随机十六进制字符串
POSTGRES_USER=chat
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_DB=chat
POSTGRES_PORT=5432

# 可选；不配置时使用 data/chat.sqlite3
# DATABASE_URL=postgresql+asyncpg://chat:replace-with-random-password@127.0.0.1:5432/chat
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# 可选 Redis 多实例实时路由；不配置即保持单实例模式
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379
REDIS_PRESENCE_LEASE_SECONDS=30
REDIS_PRESENCE_REFRESH_SECONDS=10
REDIS_SUBSCRIBER_RETRY_SECONDS=1
REDIS_OPERATION_TIMEOUT_SECONDS=1
REDIS_MAX_CONNECTIONS=20
REDIS_CHANNEL_PREFIX=bidirectional-chat
REDIS_RECENT_EVENT_TTL_SECONDS=60
REDIS_RECENT_EVENT_LIMIT=10000

# 单实例 WebSocket 资源保护
WS_MAX_MESSAGE_BYTES=16384
WS_INPUT_RATE_LIMIT_COUNT=30
WS_INPUT_RATE_LIMIT_WINDOW_SECONDS=10
WS_MAX_CONNECTIONS=1000

# 就绪检查与结构化日志
READINESS_TIMEOUT_SECONDS=1
LOG_LEVEL=INFO

# Docker Compose 映射到宿主机的端口
APP_PORT=8000
APP_SECONDARY_PORT=8001
